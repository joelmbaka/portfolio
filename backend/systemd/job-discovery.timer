[Unit]
Description=Run Portfolio production job discovery every 5 minutes
ConditionPathExists=/nonexistent/portfolio-systemd-disabled

[Timer]
OnBootSec=30s
OnStartupSec=20s
OnUnitInactiveSec=5min
AccuracySec=30s
Persistent=true
WakeSystem=true
Unit=job-discovery.service

[Install]
WantedBy=timers.target
